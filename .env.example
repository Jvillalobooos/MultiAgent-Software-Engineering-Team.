FAST_MODEL=qwen3.5:4b
DEEP_MODEL=qwen3.5:9b
CODING_MODEL=qwen3.5:9b
LOCAL_FIRST=true
MAX_LOCAL_RETRIES=1
MAX_LOCAL_REPAIRS=1
MAX_CLOUD_ESCALATIONS_PER_AGENT=1
MAX_CLOUD_ESCALATIONS_PER_RUN=3
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=300
GEMINI_API_KEY=
# Ordered Gemini pool. Position 1 leads; a cross-provider escape is inserted at
# position 2 automatically. Ordered by measured reliability, not version number.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-flash-latest
# The Developer has the hardest output contract, so its pool leads with the pro tier.
GEMINI_DEVELOPER_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-pro-preview,gemini-pro-latest,gemini-3.7-flash
# Cross-provider escape used at position 2 of every Google chain.
CLOUD_ESCAPE_MODEL=openai/gpt-oss-120b
# Roles whose payload exceeds the escape provider's tokens-per-minute cap (HTTP 413).
CLOUD_ESCAPE_TAIL_ROLES=developer
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
CLOUD_ENABLED=false
WORKSPACE_ROOT=workspace/runs
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=160
RAG_TOP_K=4
RAG_FETCH_K=8
RAG_MIN_RELEVANCE=0.55
RAG_PERSIST_DIRECTORY=rag/chroma
